PORT=3001
# Required in production. Use a managed PostgreSQL database.
DATABASE_URL=postgresql://user:password@host:5432/cloudlaunch
# Optional shared workspace password. Set a strong value for public deployment.
WORKSPACE_PASSWORD=
# Local development uses a file database when DATABASE_URL is absent.
DATA_DIR=.data

# Isolate CloudLaunch tables when sharing a PostgreSQL instance.
DATABASE_SCHEMA=cloudlaunch
